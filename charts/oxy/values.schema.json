{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "oxy chart values",
  "description": "Input contract for the oxy application chart. Intentionally permissive at the root (additionalProperties allowed) so existing oxy-app value sets validate unchanged; the well-known structures below are type-checked. Tighten per-object over time.",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "app": {
      "type": "object",
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "imageTag": { "type": "string" },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "port": { "type": "integer" },
        "internalHost": { "type": "string" }
      }
    },
    "appServer": {
      "type": "object",
      "properties": {
        "inprocGlobalWorker": { "type": "boolean" }
      }
    },
    "compileBoundary": {
      "type": "object",
      "properties": { "blobS3Bucket": { "type": "string" } }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "serveFleet": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "ideUpstream": { "type": "string" },
        "progressive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "scaleDown": { "type": "string", "enum": ["never", "onsuccess", "progressively"] },
            "maxSurge": {
              "anyOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "pattern": "^[0-9]+%$" },
                { "type": "null" }
              ]
            },
            "maxUnavailable": {
              "anyOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "pattern": "^[0-9]+%$" },
                { "type": "null" }
              ]
            },
            "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "progressDeadlineAbort": { "type": "boolean" },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "object", "minProperties": 1, "maxProperties": 1 }
            },
            "analysis": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": { "type": "string" },
                "job": { "type": "string", "minLength": 1 },
                "canaryHashLabel": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
                "rateWindow": { "type": "string", "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$" },
                "initialDelay": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
                "interval": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
                "count": { "type": "integer", "minimum": 1 },
                "failureLimit": { "type": "integer", "minimum": 0 },
                "inconclusiveLimit": { "type": "integer", "minimum": 0 },
                "consecutiveErrorLimit": { "type": "integer", "minimum": 0 },
                "dryRun": { "type": "boolean" },
                "errorRate": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "max": { "type": "number", "minimum": 0, "maximum": 1 },
                    "excludeRoutes": { "type": "string", "minLength": 1 }
                  }
                },
                "latencyP95": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "maxSeconds": { "type": "number", "exclusiveMinimum": 0 },
                    "excludeRoutes": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "ingressClassName": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "accessMode": { "type": "string" },
        "storageClassName": { "type": "string" },
        "mountPath": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": { "port": { "type": "integer" } }
    },
    "env": {
      "type": "object",
      "description": "Flat map of environment variables passed to every workload. Values must be strings (quote numbers/bools)."
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "envSecretNames": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
